{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build DellSmmFanControl",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/DellSmmFanControl/DellSmmFanControl.csproj",
        "--configuration",
        "Debug",
        "--nologo"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
