<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Title>Dell SMM Fan Control</Title>
    <Product>Dell SMM Fan Control</Product>
    <Version>0.1.0</Version>
    <Description>Desktop fan control and CPU temperature monitoring for compatible Dell SMM firmware.</Description>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\fan.ico</ApplicationIcon>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <Compile Update="MainWindows.cs" SubType="Form" />
    <Compile Update="MainWindows.Designer.cs" DependentUpon="MainWindows.cs" />
    <EmbeddedResource Update="MainWindows.resx" DependentUpon="MainWindows.cs" />
    <EmbeddedResource Include="Assets\fan.ico" LogicalName="DellSmmFanControl.FanIcon" />
    <Content Include="..\dependencies\bzh_dell_smm_io_x64.sys" Link="bzh_dell_smm_io_x64.sys" ExcludeFromSingleFile="true" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\dependencies\DellSmm-LICENSE.txt" Link="ThirdParty\DellSmm-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\dependencies\NOTICE.txt" Link="ThirdParty\NOTICE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\LICENSE.md" Link="LICENSE.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\NOTICE.md" Link="NOTICE.md" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
